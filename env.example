# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
DATABASE_URL=sqlite:///db.sqlite3

# Email Settings (for SMS verification)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMS Settings (for phone verification)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms.ir/v1/send/verify

# Redis Settings (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Media and Static Files
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# API Settings
API_RATE_LIMIT=1000
API_RATE_LIMIT_PERIOD=3600

# Cache Settings
CACHE_TTL=300
CACHE_MAX_ENTRIES=1000

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

# Location Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
DEFAULT_LATITUDE=35.6892
DEFAULT_LONGITUDE=51.3890

# Notification Settings
PUSH_NOTIFICATION_KEY=your-push-notification-key
FCM_SERVER_KEY=your-fcm-server-key

# Payment Gateway (if needed)
PAYMENT_GATEWAY_API_KEY=your-payment-api-key
PAYMENT_GATEWAY_SECRET=your-payment-secret

# Social Media Integration
INSTAGRAM_API_KEY=your-instagram-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=your-ga-id

# Development Settings
DEVELOPMENT_MODE=True
ENABLE_DEBUG_TOOLBAR=False
ENABLE_SILK_PROFILING=False
